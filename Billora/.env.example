# Server & Application
# Local Development:
NODE_ENV=development
NEXT_PUBLIC_APP_URL=http://localhost:3000
# In Vercel Environment Variables:
# NEXT_PUBLIC_APP_URL=https://billora-subscription-billing-manage.vercel.app

# Database (Prisma) - e.g. Neon Cloud PostgreSQL
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require"

# Authentication (Auth.js / NextAuth v5)
# Generate via: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
NEXTAUTH_SECRET=your-nextauth-secret-here
AUTH_SECRET=your-nextauth-secret-here
AUTH_TRUST_HOST=true

# Authentication Base URL:
# Local Development: http://localhost:3000
# In Vercel Environment Variables: https://billora-subscription-billing-manage.vercel.app
NEXTAUTH_URL=http://localhost:3000
AUTH_URL=http://localhost:3000

# Payment Simulator (Optional)
STRIPE_SECRET_KEY=your-stripe-secret-key
STRIPE_WEBHOOK_SECRET=your-stripe-webhook-secret
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=your-stripe-publishable-key
